# =============================================================
#  pozo.com.py — Apache / LiteSpeed (Hostinger)
#  URLs limpias, HTTPS, compresión y caché.
# =============================================================

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ── 1. HTTPS + www → sin www ────────────────────────────────
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://pozo.com.py%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.pozo\.com\.py$ [NC]
RewriteRule ^ https://pozo.com.py%{REQUEST_URI} [R=301,L]

# Dominio hermano que también controlamos → canoniza a pozo.com.py
RewriteCond %{HTTP_HOST} ^(www\.)?pozos\.com\.py$ [NC]
RewriteRule ^ https://pozo.com.py%{REQUEST_URI} [R=301,L]

# ── 2. Sacar .php visible de la barra de direcciones ────────
#     /pozos-artesianos.php → 301 → /pozos-artesianos
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

#     /index.php e /index → /
RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# ── 3. Sacar la barra final (excepto en directorios reales) ─
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/$ /$1 [R=301,L]

# ── 4. Rutas anidadas explícitas ────────────────────────────
#     /pozos-artesianos/precio-metro → pozos-artesianos-precio-metro.php
RewriteRule ^pozos-artesianos/precio-metro$ pozos-artesianos-precio-metro.php [L]

# ── 5. Mapeo genérico: /slug → slug.php ─────────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([^/.]+)$ $1.php [L]

# ── 6. 404 propio ───────────────────────────────────────────
ErrorDocument 404 /404.php
</IfModule>

# ── 7. Los includes y los logs no se sirven por HTTP ────────
<IfModule mod_rewrite.c>
RewriteRule ^includes/ - [F,L]
</IfModule>
<FilesMatch "\.(log|md|bak|ini|sql)$">
  Require all denied
</FilesMatch>

# ── 8. Compresión ───────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── 9. Caché del navegador ──────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|webp|jpg|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

AddDefaultCharset UTF-8
